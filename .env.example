# ค่าสำหรับ Vercel > Project > Settings > Environment Variables
# วิธีใช้: กรอกค่าหลังเครื่องหมาย = ให้ครบ แล้วกด "Import .env" ใน Vercel เลือกไฟล์นี้
# (หรือคัดลอกทั้งหมดไปวางในช่อง Key ของ Vercel) แล้ว Redeploy หนึ่งครั้ง
# อย่า commit ไฟล์ที่มีค่าจริงขึ้น GitHub (ไฟล์ .env ถูก .gitignore กันไว้แล้ว)

# LINE Developers > channel ของ Quizzy > Basic settings > Channel ID (ตัวเลข 10 หลัก)
LINE_CHANNEL_ID=

# Supabase > Project Settings > API Keys > Project URL เช่น https://abcdxyz.supabase.co
SUPABASE_URL=

# Supabase > Project Settings > API Keys > Secret key (sb_secret_...) หรือ service_role key แบบเก่า
# เป็นความลับ: ตอนนำเข้าให้เปิด Sensitive ไว้
SUPABASE_SERVICE_ROLE_KEY=
